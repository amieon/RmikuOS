+#!/bin/sh
+# diag_linked_elf.sh — RmikuOS TCC LoongArch64: 宿主侧完整链接诊断
+#
+# 在 Docker 宿主(有 loongarch64-unknown-linux-gnu-* 工具链)运行:
+#     sh ~/RmikuOS/user/tcc/diag_linked_elf.sh [测试号, 默认 01]
+#
+# 目的: 用宿主编译的 tcc(与镜像内 tcc.elf 同源码)完整链接一个测试程序,
+#       得到可 objdump 的 ELF, 直接定位 QEMU trap 中 era 指向的指令。
+#
+# 注意: 宿主编译必须加 -DCONFIG_TCC_CRTPREFIX 等, 否则 tcc 在默认路径
+#       (/usr/lib) 找 crt1.o/crti.o 而报 "file 'crt1.o' not found"。
+
+TC=loongarch64-unknown-linux-gnu
+RMOS=${RMOS:-$HOME/RmikuOS}
+SYS=$RMOS/user/build/loongarch64/tcc-sys/usr/lib/tcc
+TN=${1:-01}
+SRC=$(ls $RMOS/user/rootfs/codes/t${TN}_*.c 2>/dev/null | head -1)
+
+if [ -z "$SRC" ]; then echo "找不到 t${TN}_*.c"; exit 1; fi
+if [ ! -f "$SYS/crt1.o" ]; then
+    echo "!! $SYS/crt1.o 不存在 —— 先跑一遍完整构建 (./run.sh loongarch64 或 python3 user/build.py loongarch64)"
+    ls -la "$SYS" 2>/dev/null
+    exit 1
+fi
+
+echo "=== [1] 宿主编译 tcc (LoongArch64 目标) ==="
+cd "$RMOS/user/tcc/tcc-src" || exit 1
+gcc -O1 -DTCC_TARGET_LOONGARCH64 -DONE_SOURCE=0 -I. -I.. \
+    -DCONFIG_TCC_CRTPREFIX="\"$SYS\"" \
+    -DCONFIG_TCC_LIBPATHS="\"$SYS\"" \
+    -DCONFIG_TCC_SYSINCLUDEPATHS="\"$SYS/include\"" \
+    -o /tmp/tcc-la tcc.c libtcc.c tccpp.c tccgen.c tccdbg.c tccelf.c tccasm.c tccrun.c \
+    loongarch64-gen.c loongarch64-link.c loongarch64-asm.c -lm -ldl 2>&1 | grep -v warn_unused_result || true
+[ -x /tmp/tcc-la ] || { echo "宿主 tcc 构建失败"; exit 1; }
+
+echo "=== [2] 完整链接 $SRC ==="
+/tmp/tcc-la "$SRC" -o /tmp/t$TN.elf || exit 1
+
+echo "=== [3] ELF 头 / 程序头 / _start ==="
+$TC-readelf -hW /tmp/t$TN.elf | grep -Ei 'entry|type:|machine' 
+$TC-readelf -lW /tmp/t$TN.elf
+$TC-objdump -d /tmp/t$TN.elf | sed -n '/<_start>:/,+14p'
+
+echo "=== [4] 输入对象的重定位类型统计(对照 loongarch64-link.c 覆盖情况) ==="
+for f in "$SYS/crt1.o" "$SYS/runmain.o"; do
+    echo "--- $f"
+    $TC-readelf -rW "$f" 2>/dev/null | grep -o 'R_LARCH_[A-Z0-9_]*' | sort | uniq -c
+done
+echo "--- libc.a 全部成员"
+$TC-readelf -rW "$SYS/libc.a" 2>/dev/null | grep -o 'R_LARCH_[A-Z0-9_]*' | sort | uniq -c
+echo "--- libtcc1.a 全部成员"
+$TC-readelf -rW "$SYS/libtcc1.a" 2>/dev/null | grep -o 'R_LARCH_[A-Z0-9_]*' | sort | uniq -c
+
+echo "=== [5] QEMU trap era 在本 ELF 中的定位 ==="
+$TC-objdump -d /tmp/t$TN.elf > /tmp/t$TN.dis
+for a in 12974 1e13c 12a9c 12998 1ecfc 1dd5c 1347c 15990 127fc 17484 12ad4 1df5c; do
+    if grep -q "^    $a:" /tmp/t$TN.dis; then
+        echo "--- era 0x$a 上下文:"
+        grep -B10 "^    $a:" /tmp/t$TN.dis | tail -13
+    fi
+done
+
+echo "=== [6] .got 段内容(GOT 槽应填入符号地址, 不应为 0) ==="
+$TC-objdump -s -j .got /tmp/t$TN.elf 2>/dev/null || echo "(无 .got 段)"
+
+echo "=== [7] la.got 使用点抽查(含 GOT_PC 重定位的函数) ==="
+grep -n "GOT_PC" /tmp/t$TN.dis | head -5
+grep -B2 -A2 "ld.d.*\$t" /tmp/t$TN.dis | grep -A4 -B2 pcalau12i | head -30
+
+echo "完成: /tmp/t$TN.elf 与 /tmp/t$TN.dis 已生成, 请把 [3][5][6] 输出贴回。"
