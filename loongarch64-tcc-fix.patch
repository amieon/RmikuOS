+        addr_t got = s1->got->sh_addr + get_sym_attr(s1, sym_index, 0)->got_offset;
+        uint32_t insn = read32le(ptr);
+        insn = (insn & 0xffc003ffu) | ((got & 0xfff) << 10);
+        write32le(ptr, insn);
+        return;
+    }
+    case R_LARCH_GOT_HI20: {
+        /* 79: 绝对形式 lu12i.w + ld.d, 同样用 GOT 槽地址 */
+        addr_t got = s1->got->sh_addr + get_sym_attr(s1, sym_index, 0)->got_offset;
