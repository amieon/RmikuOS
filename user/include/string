#pragma once

#include "stdimpl/compat.h"    // operator new/delete（malloc/free 后端）、size_t
#include "stdimpl/vector.h"    // mv::Vector：my::string 的底层存储
#include "stdimpl/string.h"    // my::string

namespace std {
    using string = my::string;
}
namespace std {
    inline double stod(const string& s) { return mystr::str_to_double(s.c_str()); }
    inline int stoi(const string& s) { return mystr::str_to_int(s.c_str()); }
}
