  whoami              (print effective user name)
  chmod <mode> <path> (mode is octal, e.g. 755 / 0644)
  rename <old> <new> (mv <old> <new> also works; ...)
  jobs
  clear
  export NAME=VALUE   (set env var; $VAR / ${VAR} / $? expands in commands)
  env                 (print all env vars)
  unset NAME          (remove env var)
  variable expansion: $VAR, ${VAR}, $? (last exit code)
    'single quotes' protect $; "double quotes" still expand $ (bash style)
  shutdown

external commands are in $PATH (/bin, /tests, /programs):
  try: ls /bin

